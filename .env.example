# Copy to backend/.env and fill in. Without GEMMA_API_KEY the backend returns
# no verdicts (extraction + judging both require it).
GEMMA_API_KEY=
TAVILY_API_KEY=
# Optional. If unset, GEMMA_API_KEY is reused (same Google project must have
# the Fact Check Tools API enabled in Google Cloud console).
GOOGLE_FACTCHECK_API_KEY=

# Fact-check uAgent (run via scripts/run_factcheck_agent.py).
# Stable seed -> stable address across restarts.
FACTCHECK_AGENT_SEED=
# Filled in after the first agent run prints its address.
FACTCHECK_AGENT_ADDRESS=
# Optional: Agentverse Mailbox API key (JWT) from agentverse.ai.
# If set, the agent auto-registers with Agentverse without the inspector UI
# flow. Get one at agentverse.ai -> My Agents -> + New -> Mailbox.
AGENTVERSE_MAILBOX_KEY=

# Local SQLite vector cache
CACHE_DB_PATH=./cache.db

# Backend listen address
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=*
