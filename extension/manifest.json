{
  "manifest_version": 3,
  "name": "Niwas — Real-Time Fact Checker",
  "version": "0.1.0",
  "description": "Real-time fact-checks YouTube videos using captions or tab audio.",
  "action": {
    "default_title": "Niwas",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "ws://localhost/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-injector.js", "overlay/overlay.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
